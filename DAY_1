#QN 3
a, b = map(int, input().split())
if a > b:
    print(f"{a} is largest")
else:
    print(f"{b} is largest")


#QN 4
a, b, c = map(int, input().split())
if a >= b and a >= c:
    print(f"{a} is largest")
elif b >= a and b >= c:
    print(f"{b} is largest")
else:
    print(f"{c} is largest")


